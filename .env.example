# 复制为 .env 后填写。没有任何 key 时程序使用「演示数据」，可以先体验界面。

# Google Flights 数据（主数据源）：https://serpapi.com 注册后在 Dashboard 复制 API key
SERPAPI_KEY=

# 航司直连报价（第二数据源）：https://app.duffel.com 注册，Developers → Access tokens
DUFFEL_TOKEN=

# 免费缓存价，用于灵活日期和「任意目的地」：https://www.travelpayouts.com 注册，Profile → API token
TRAVELPAYOUTS_TOKEN=

# 显示货币、默认出发机场
CURRENCY=GBP
HOME_AIRPORT=MAN

# 每月 SerpApi 调用上限（防止超预算）
SERPAPI_MONTHLY_LIMIT=250

# 查询结果缓存分钟数
CACHE_MINUTES=30

# 航线监控：每隔多少小时自动查一次
WATCH_INTERVAL_HOURS=12

# 提醒方式（可选，填哪个用哪个）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 特价网站 RSS，逗号分隔
DEAL_FEEDS=https://www.secretflying.com/feed/
